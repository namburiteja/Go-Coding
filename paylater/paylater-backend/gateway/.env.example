# Gateway — edge proxy only (no database)
# Copy to .env. Defaults are for: docker compose up -d

PORT=9090

ADMIN_SERVICE_URL=http://admin:9091
MERCHANT_SERVICE_URL=http://merchant:9092
CUSTOMER_SERVICE_URL=http://customer:9093
LEDGER_SERVICE_URL=http://ledger:9094
REPORT_SERVICE_URL=http://report:9095

# Comma-separated browser origins allowed to call the gateway.
# Defaults (when unset): http://localhost:5173,http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Local go run (services on host):
# ADMIN_SERVICE_URL=http://localhost:9091
# MERCHANT_SERVICE_URL=http://localhost:9092
# CUSTOMER_SERVICE_URL=http://localhost:9093
# LEDGER_SERVICE_URL=http://localhost:9094
# REPORT_SERVICE_URL=http://localhost:9095

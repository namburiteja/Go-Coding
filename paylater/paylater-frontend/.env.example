# Gateway API base URL (do not point at individual microservice ports).
#
# Local Vite (npm run dev) — browser calls the gateway on the host:
VITE_API_BASE_URL=http://localhost:9090
#
# Dockerized UI: Dockerfile builds with VITE_API_BASE_URL=/api and nginx
# proxies /api/* → http://gateway:9090/* (Compose service name).
# Do not bake http://localhost:... into the Docker image for API calls.

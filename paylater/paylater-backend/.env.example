# This file is NOT loaded by any service.
# Copy each service example instead:
#   gateway/.env.example              -> gateway/.env
#   services/admin/.env.example       -> services/admin/.env
#   services/merchant/.env.example    -> services/merchant/.env
#   services/customer/.env.example    -> services/customer/.env
#   services/ledger/.env.example      -> services/ledger/.env
#   services/report/.env.example      -> services/report/.env
# Keep JWT_SECRET and INTERNAL_SERVICE_TOKEN identical everywhere they appear.
# Then: docker compose up -d
